# Copy to .env and fill in. NEVER commit .env. NEVER put these keys in frontend code.
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./mova.db

# External providers (leave blank to run with no external API)
GOOGLE_MAPS_API_KEY=
WEATHER_API_KEY=

# Optional LLM layer (Phase L). LLM_PROVIDER: none | openai | anthropic | gemini
LLM_PROVIDER=none
LLM_API_KEY=

# Comma-separated origins allowed to call the API from a browser
# (5500 = VS Code Live Server default)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Synthetic data is for development/testing only. Set false in production.
ALLOW_SYNTHETIC_DATA=true
